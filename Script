local function _b64(d)
	if crypt and crypt.base64decode then return crypt.base64decode(d) end
	if syn and syn.crypt and syn.crypt.base64 and syn.crypt.base64.decode then return syn.crypt.base64.decode(d) end
	if base64 and base64.decode then return base64.decode(d) end
	local B="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
	d=string.gsub(d,"[^"..B.."=]","")
	local t,n,buf,bits={},1,0,0
	for i=1,#d do
		local c=d:sub(i,i)
		if c~="=" then
			local v=B:find(c)-1
			buf=buf*64+v
			bits=bits+6
			if bits>=8 then
				bits=bits-8
				t[n]=string.char(math.floor(buf/2^bits)%256)
				n=n+1
			end
		end
	end
	return table.concat(t)
end
local function _xor(s,k)
	local kn,out,oi,i,n=#k,{},1,1,#s
	local bxor=bit32 and bit32.bxor
	while i<=n do
		local last=math.min(i+2047,n)
		local ch,ci={},1
		if bxor then
			while i<=last do
				ch[ci]=string.char(bxor(s:byte(i),k[((i-1)%kn)+1]))
				ci=ci+1; i=i+1
			end
		else
			while i<=last do
				local a,b=s:byte(i),k[((i-1)%kn)+1]
				local r,p=0,1
				while a>0 or b>0 do
					local am,bm=a%2,b%2
					if am~=bm then r=r+p end
					a,b,p=(a-am)/2,(b-bm)/2,p*2
				end
				ch[ci]=string.char(r)
				ci=ci+1; i=i+1
			end
		end
		out[oi]=table.concat(ch)
		oi=oi+1
	end
	return table.concat(out)
end
